# Where the browser sends API calls. Not a secret: never put API keys in NEXT_PUBLIC_* variables.
#   Local dev: the FastAPI backend directly (CORS is configured in the backend).
#   Production: "/" = this site; next.config.ts proxies /api/v1/* to API_BASE_URL so the refresh cookie is
#   first-party (see DEPLOY.md).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Backend URL for server-side rendering and, when set, the /api/v1/* proxy. Required when the above is "/".
# Defaults to NEXT_PUBLIC_API_BASE_URL, with "localhost" swapped for 127.0.0.1 (avoids a ~200 ms IPv6
# fallback on every connection on Windows).
API_BASE_URL=
# Optional: where live-price streams (SSE) connect. In production, the backend URL directly, since the proxy
# isn't meant for long-lived streams. Defaults to NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_STREAM_BASE_URL=
