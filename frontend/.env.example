# Base URL of the MarketPulse FastAPI backend. Not a secret: the browser calls it directly (CORS is
# configured in the backend). Never put API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional: a different backend URL for server-side rendering (e.g. inside Docker). Defaults to the above.
API_BASE_URL=
