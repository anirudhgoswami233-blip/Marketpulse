# Copy to backend/.env and fill in. Never commit .env.

# Finnhub (primary market data) — get a free key at https://finnhub.io (key is on the dashboard)
FINNHUB_API_KEY=

# Twelve Data (approved fallback: price history + forex rates) — free key at https://twelvedata.com
TWELVEDATA_API_KEY=

# FRED (macro data) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# "dev" locally. Anything else (e.g. "production") requires JWT_SECRET and REDIS_URL.
ENV=dev

# Database: SQLite for dev, PostgreSQL in prod. Neon's/Render's postgresql://...?sslmode=require URLs work as-is
# (they're converted for the asyncpg driver).
DATABASE_URL=sqlite+aiosqlite:///./marketpulse.db

# Redis: leave empty in dev to use the in-memory cache/limiter backend
REDIS_URL=

# JWT signing secret: required outside dev, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in dev, a random per-process secret is used (sign-ins then last only until a restart).
JWT_SECRET=
# Set true behind HTTPS so the refresh-token cookie is Secure.
COOKIE_SECURE=false

# Bearer secret for POST /api/v1/internal/jobs/run and GET /api/v1/internal/jobs (an external scheduler,
# e.g. GitHub Actions, wakes a sleeping host and runs the brief and signal-outcome jobs). Empty disables them.
CRON_SECRET=

# Frontend origins allowed to call the API (JSON list) and an optional regex for more (e.g. Vercel previews).
CORS_ORIGINS=["http://localhost:3000"]
CORS_ORIGIN_REGEX=

# Optional: enables LLM rewriting of the Daily Brief
LLM_API_KEY=

# Optional: email delivery of the Daily Brief
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional tuning (defaults shown)
# ENABLE_BACKGROUND_JOBS=true        # scheduled jobs, e.g. the markets-overview snapshot
# ENABLE_STREAMING=true              # the shared Finnhub WebSocket for live prices
# OVERVIEW_REFRESH_OPEN_S=300        # overview snapshot refresh while the US market is open
# OVERVIEW_REFRESH_CLOSED_S=1800
# PAPER_STARTING_CASH=100000
